{
  "id": "lyft_bike_share",
  "name": "Lyft Bike Share",
  "version": "2.0.2",
  "description": "Display Lyft bike share availability with electric and classic bike counts. Works with Bay Wheels, CitiBike, Capital Bikeshare, Biketown, Divvy, and other Lyft-operated systems.",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--baywheels",
  "documentation": "README.md",
  "icon": "bike",
  "category": "transit",
  "min_refresh_seconds": 30,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Lyft Bike Share",
        "default": false
      },
      "gbfs_base_url": {
        "type": "string",
        "title": "GBFS Feed URL",
        "description": "Base URL for your local Lyft bike share GBFS feed. Examples: https://gbfs.baywheels.com/gbfs/en (Bay Wheels), https://gbfs.citibikenyc.com/gbfs/en (CitiBike NYC), https://gbfs.capitalbikeshare.com/gbfs/en (Capital Bikeshare DC), https://gbfs.biketownpdx.com/gbfs/en (Biketown Portland), https://gbfs.divvybikes.com/gbfs/en (Divvy Chicago)",
        "default": "https://gbfs.baywheels.com/gbfs/en"
      },
      "station_ids": {
        "type": "array",
        "title": "Station IDs",
        "description": "Lyft bike share station IDs to monitor",
        "items": {
          "type": "string"
        },
        "ui:widget": "lyft-bikeshare-station-picker"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "default": 60,
        "minimum": 30
      }
    },
    "required": [
      "gbfs_base_url",
      "station_ids"
    ]
  },
  "env_vars": [
    {
      "name": "LYFT_BIKESHARE_ENABLED",
      "required": false,
      "description": "Enable Lyft Bike Share feature",
      "default": "false"
    },
    {
      "name": "LYFT_BIKESHARE_GBFS_BASE_URL",
      "required": false,
      "description": "Base URL for your local Lyft bike share GBFS feed",
      "default": "https://gbfs.baywheels.com/gbfs/en"
    },
    {
      "name": "LYFT_BIKESHARE_STATION_IDS",
      "required": false,
      "description": "Comma-separated list of station IDs"
    }
  ],
  "variables": {
    "groups": {
      "station": {
        "label": "First Station"
      },
      "totals": {
        "label": "Totals"
      },
      "best": {
        "label": "Best Station"
      }
    },
    "simple": {
      "electric_bikes": {
        "description": "Electric bikes at first station",
        "type": "number",
        "max_length": 2,
        "group": "station",
        "example": "5"
      },
      "classic_bikes": {
        "description": "Classic bikes at first station",
        "type": "number",
        "max_length": 2,
        "group": "station",
        "example": "3"
      },
      "num_bikes_available": {
        "description": "Total bikes at first station",
        "type": "number",
        "max_length": 2,
        "group": "station",
        "example": "8"
      },
      "is_renting": {
        "description": "Whether first station is renting",
        "type": "boolean",
        "max_length": 3,
        "group": "station",
        "example": "Yes"
      },
      "station_name": {
        "description": "Name of first station",
        "type": "string",
        "max_length": 10,
        "group": "station",
        "example": "Market St"
      },
      "system_name": {
        "description": "Name of the configured bike share system",
        "type": "string",
        "max_length": 10,
        "group": "station",
        "example": "Bay Wheels"
      },
      "status_color": {
        "description": "Color code for availability status",
        "type": "string",
        "max_length": 4,
        "group": "station",
        "example": "{63}"
      },
      "total_electric": {
        "description": "Total electric bikes across all stations",
        "type": "number",
        "max_length": 2,
        "group": "totals",
        "example": "12"
      },
      "total_classic": {
        "description": "Total classic bikes across all stations",
        "type": "number",
        "max_length": 2,
        "group": "totals",
        "example": "8"
      },
      "total_bikes": {
        "description": "Total bikes across all stations",
        "type": "number",
        "max_length": 2,
        "group": "totals",
        "example": "20"
      },
      "station_count": {
        "description": "Number of monitored stations",
        "type": "number",
        "max_length": 1,
        "group": "totals",
        "example": "3"
      },
      "best_station_name": {
        "description": "Station with most electric bikes",
        "type": "string",
        "max_length": 10,
        "group": "best",
        "example": "Powell St"
      },
      "best_station_electric": {
        "description": "Electric bikes at best station",
        "type": "number",
        "max_length": 2,
        "group": "best",
        "example": "7"
      },
      "best_station_id": {
        "description": "Station ID of best station",
        "type": "string",
        "max_length": 15,
        "group": "best",
        "example": "abc123"
      }
    },
    "arrays": {
      "stations": {
        "label_field": "station_name",
        "item_fields": [
          "station_id",
          "station_name",
          "electric_bikes",
          "classic_bikes",
          "num_bikes_available",
          "is_renting",
          "status_color"
        ]
      }
    }
  },
  "max_lengths": {
    "stations.*.station_name": 10,
    "stations.*.electric_bikes": 2,
    "stations.*.classic_bikes": 2,
    "stations.*.status_color": 4
  },
  "color_rules_schema": {
    "electric_bikes": {
      "type": "threshold",
      "description": "Color based on electric bike count",
      "default_rules": [
        {
          "condition": ">",
          "value": 5,
          "color": "green"
        },
        {
          "condition": ">=",
          "value": 2,
          "color": "yellow"
        },
        {
          "condition": "<",
          "value": 2,
          "color": "red"
        }
      ]
    }
  },
  "fiestaboard_version": ">=2.10.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Lyft Bike Share displayed on a Vestaboard",
      "caption": "Display Lyft bike share availability with electric and classic bike counts",
      "primary": true
    }
  ],
  "demo": {
    "flagship": {
      "name": "Lyft Bike Share Demo",
      "template": [
        "BIKE SHARE",
        "{{lyft_bike_share.station_name}}",
        "E-Bikes {{lyft_bike_share.electric_bikes}}",
        "Classic {{lyft_bike_share.classic_bikes}}",
        "Total {{lyft_bike_share.num_bikes_available}}",
        "Stations {{lyft_bike_share.station_count}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Bike Share (Note)",
      "template": [
        "BIKE SHARE",
        "E-BIKE {{lyft_bike_share.electric_bikes}}",
        "TOTAL {{lyft_bike_share.num_bikes_available}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
